# ROSA environment template.
#
# Copy to `.env` and fill in only what you need. Nothing here is required
# except the secrets and the OAuth pair you enable; provider Base URLs and API
# keys live in the database, not in the environment, so users can add their own.

# ---------------------------------------------------------------------------
# Clerk Authentication (Security Priority)
# ---------------------------------------------------------------------------
#
# Clerk manages user identities, multi-factor authentication, and JWT sessions.
# The Cloudflare Worker verifies RS256 cryptographic signatures against Clerk's
# JSON Web Key Set (JWKS) before allowing access to user data.
#
# Obtain keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_bmV1dHJhbC1zbmlwZS04NjQ2LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_PUBLISHABLE_KEY=pk_test_bmV1dHJhbC1zbmlwZS04NjQ2LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_...
CLERK_DOMAIN=neutral-snipe-8646.clerk.accounts.dev

# ---------------------------------------------------------------------------
# Supabase PostgreSQL Storage
# ---------------------------------------------------------------------------
#
# Cloudflare Worker connects to Supabase PostgreSQL using serverless HTTP pooling
# (@neondatabase/serverless or @supabase/supabase-js).
#
# Obtain from your Supabase project dashboard -> Settings -> Database:
SUPABASE_DB_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# 256-bit encryption key for provider API keys at rest, base64url-encoded.
# Generate one with:
#   npm run keys:generate
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Must be at least 32 characters. A shorter value is REFUSED rather than used:
# the key derives AES-256, so a weak one would silently weaken every stored
# credential. There is no "it still works" path.
#
# WITHOUT THIS: the server still runs, but provider API keys cannot be
# persisted. `GET /api/health` reports keyStorage as "session-only" and the
# login screen says so. Users can still paste a key for the current session.
#
# ROTATING THIS INVALIDATES EVERY STORED KEY. Users must re-enter them.
ROSA_ENCRYPTION_KEY=

# Secret used to sign session cookies. Must be at least 32 characters.
# If unset, dev mode gets a known-bad fallback and production refuses to start.
ROSA_SESSION_SECRET=

# ---------------------------------------------------------------------------
# URLs, sessions, transport policy
# ---------------------------------------------------------------------------

# Absolute public URL of the front end, used to build OAuth redirect URIs.
# Defaults to http://localhost:5173 in dev.
ROSA_PUBLIC_APP_URL=

# Path prefix for the API. Defaults to /api.
ROSA_API_PREFIX=/api

# Set to 1 only in local development. It relaxes the SSRF guard so that
# loopback Base URLs (localhost, 127.0.0.1) are accepted for local models such
# as Ollama or LM Studio. Never set this in production.
ROSA_ALLOW_LOCAL_HTTP=

# Set to 1 to enable development conveniences. Never set this in production.
ROSA_DEV_MODE=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
#
# The primary deployment target is Vercel functions backed by Cloudflare D1,
# reached over D1's HTTP API. That is why the Cloudflare REST variables below
# appear in a Vercel deployment: D1 is the free-tier database, not the host.
#
# The driver is chosen automatically from whichever group is populated:
#   CLOUDFLARE_*  → d1-rest (Vercel, or any Node host)
#   DATABASE_URL + DATABASE_AUTH_TOKEN → libsql/Turso, or a local SQLite file
#   neither       → local SQLite file at ROSA_DB_PATH
#
# Postgres/Neon is NOT supported: the schema is SQLite dialect by design, so it
# can run unchanged on D1, Turso and a local file.

# --- Cloudflare D1 over the REST API (used by the Vercel deployment) ---

# From `wrangler whoami`, or the Cloudflare dashboard URL.
CLOUDFLARE_ACCOUNT_ID=

# Create the database with:
#   npx wrangler d1 create rosa-db
# Copy the id it prints.
CLOUDFLARE_D1_DATABASE_ID=

# API token with the "D1 Edit" permission. Create at:
#   https://dash.cloudflare.com/profile/api-tokens
# Server-side only — never prefix this with VITE_.
CLOUDFLARE_API_TOKEN=

# Override only for testing (e.g. a local mock). Leave blank in production.
CLOUDFLARE_API_BASE_URL=

# --- libsql / Turso (the non-Cloudflare alternative) ---
#
# Free tier: https://turso.tech. Create with `turso db create rosa`, then:
#   turso db show rosa --url            → DATABASE_URL
#   turso db tokens create rosa         → DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Local SQLite (default when nothing above is set) ---

# SQLite file path used by the local Node server. Defaults to
# ./data/rosa.sqlite.
ROSA_DB_PATH=./data/rosa.sqlite

# D1 binding name. Must match the `binding` in wrangler.jsonc. Only read by the
# Cloudflare Worker path, which takes D1 as a platform binding rather than over
# HTTP.
#
# NOTE: this is documentation, not configuration. A Worker receives its bindings
# from wrangler.jsonc, so no variable here is read at runtime for that path.
ROSA_D1_BINDING=rosa_db

# Set to 0 to skip the automatic schema migration on boot. The default (on)
# applies migrations once per fresh database; `schema_migrations` makes every
# later boot a single cheap read.
ROSA_AUTO_MIGRATE=

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------

# Port for `rosa-server` (the local Node API server). The Vite dev proxy points
# at the same port, so change both together.
ROSA_API_PORT=8787

# ---------------------------------------------------------------------------
# OAuth (sign-in UI only lists the providers configured here)
# ---------------------------------------------------------------------------

# GitHub OAuth app. Create one at
# https://github.com/settings/developers → New OAuth App.
#   Authorization callback URL: {ROSA_PUBLIC_APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (Web application type).
#   Authorized redirect URI: {ROSA_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated allowlist of extra origins permitted to call the API.
# The app's own origin is always allowed.
ROSA_CORS_ORIGINS=
